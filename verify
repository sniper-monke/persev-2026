const fs = require('fs');
const assert = (cond, msg) => console.log(cond ? '  PASS: ' + msg : '  FAIL: ' + msg);

console.log('=== VERIFICATION ===\n');

// 1. Bundle patches
let b = fs.readFileSync('persev-2025-website/public/assets/index-GnKc23iY.js', 'utf8');
console.log('Bundle mobile/WebKit behavior:');
assert(/antialias:![A-Za-z_$][\w$]*/.test(b), 'antialias iOS off');
assert(/powerPreference:[A-Za-z_$][\w$]*\?"default":"high-performance"/.test(b), 'powerPreference iOS default');
assert(/castShadow:![A-Za-z_$][\w$]*/.test(b), 'castShadow iOS off (mesh)');
assert(b.includes('?64:256'), 'shadow map size reduced');
assert(b.includes('navigator.platform==="MacIntel"&&navigator.maxTouchPoints>1'), 'iPadOS desktop UA detection added');
assert(b.includes('Math.min(window.devicePixelRatio,1.5)'), 'iOS DPR raised above 1 while capped');
assert(b.includes('=192,'), 'mobile sphere segments raised to 192');
assert(b.includes('Zg(RM)'), 'all gradient textures preloaded');
assert(b.includes('?RM[0]:"/envmap.jpg"'), 'iOS skips large envmap texture');
assert(b.includes('envMap:') && b.includes('?null:'), 'env map disabled on iOS material');
assert(b.includes('.slice(0,1)'), 'spotlights reduced to one on iOS');
assert(/enableDamping:![A-Za-z_$][\w$]*/.test(b), 'orbit damping disabled on iOS');
assert(b.includes('?.08:.15'), 'auto-rotation rate halved on iOS');
assert(!b.includes('setInterval(()=>{t()},1750)'), 'autoplay preset interval removed');
assert(b.includes('Perseverantia'), 'site branding preserved');
assert(b.includes('Transform'), 'display titles preserved');
assert(b.includes('setClearColor("#141518",0)'), 'canvas clear color remains transparent');

